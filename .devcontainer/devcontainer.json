{
  "name": "My First Website",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Website",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "npm install --prefix private",
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ],
      "settings": {
        "files.exclude": {
          "**/.git": true,
          "**/.gitignore": true,
          "**/.devcontainer": true,
          "**/.vscode": true,
          "**/node_modules": true,
          "**/package-lock.json": true
        }
      }
    }
  }
}
